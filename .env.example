APP_ENV=development
APP_VERSION=0.1.0
DEMO_MODE=true
DATABASE_URL=sqlite:///./ip_sakti_dev.db
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ip-sakti-demo
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ip-sakti-evidence
JWT_SECRET=change-me
JWT_ISSUER=ip-sakti
JWT_AUDIENCE=ip-sakti-client
LLM_PROVIDER=mock
LLM_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
API_KEY=
REQUIRE_API_KEY=false
API_KEY_HEADER=X-API-Key
ENABLE_RATE_LIMIT=false
RATE_LIMIT_PER_MINUTE=60
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=multilingual-demo
RERANKER_PROVIDER=heuristic
BHASHINI_ENABLED=false
BHASHINI_API_URL=
BHASHINI_API_KEY=
LEXICAL_RETRIEVER=postgres
ENABLE_GRAPH_RAG=true
ENABLE_MULTI_AGENT=true
ENABLE_ADAPTIVE_RETRIEVAL=true
ENABLE_VOICE=false
ENABLE_PAID_CONNECTORS=false
ENABLE_RESTRICTED_TKDL=false
ENABLE_EXPERT_HANDOFF=true
MAX_RETRIEVAL_RETRIES=2
DEFAULT_TOP_K=20
RERANK_TOP_K=8
MAX_EVIDENCE_ITEMS=8
AUDIT_LOGGING=true
RESTRICTED_SOURCE_POLICY=true
